import("//build/lite/config/test.gni")
import("//foundation/graphic/surface_lite/surface_lite_config.gni")

# liteos_m has no gtest infra: the unittest only builds on other kernels.
if (ohos_build_type == "debug" && ohos_kernel_type != "liteos_m") {
  group("surface_lite_test") {
    deps = [ ":surface_lite_unittest_door" ]
  }

  unittest("surface_lite_unittest_door") {
    output_extension = "bin"
    output_dir = "$root_out_dir/test/unittest/graphic"
    sources = [ "unittest/graphic_surface_test.cpp" ]
    deps = [ "//foundation/graphic/surface_lite:surface" ]
    if (ohos_kernel_type == "liteos_m") {
      deps += [ "//third_party/bounds_checking_function:libsec_static" ]
    } else {
      deps += [ "//third_party/bounds_checking_function:libsec_shared" ]
    }
    if (!surface_lite_single_process) {
      deps += [ "//foundation/communication/ipc/interfaces/innerkits/c/ipc:ipc_single" ]
    }
  }
} else {
  group("surface_lite_test") {
  }
}
