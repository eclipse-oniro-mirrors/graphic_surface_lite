import("//build/lite/config/test.gni")

# liteos_m has no gtest infra: the unittest only builds on other kernels.
if (ohos_build_type == "debug" && ohos_kernel_type != "liteos_m") {
  group("surface_lite_test") {
    deps = [ ":surface_lite_unittest_door" ]
  }

  unittest("surface_lite_unittest_door") {
    output_extension = "bin"
    output_dir = "$root_out_dir/test/unittest/graphic"
    sources = [ "unittest/graphic_surface_test.cpp" ]
    deps = [ "//foundation/graphic/surface_lite:surface" ]
    if (ohos_kernel_type == "liteos_m") {
      deps += [ "//third_party/bounds_checking_function:libsec_static" ]
    } else {
      deps += [ "//third_party/bounds_checking_function:libsec_shared" ]
    }
    if (ohos_kernel_type != "liteos_m") {
      deps += [ "//foundation/communication/ipc/interfaces/innerkits/c/ipc:ipc_single" ]
    }
  }
} else {
  group("surface_lite_test") {
  }
}

# Single-process full-flow example (example/surface_single_process_example.cpp):
# host-machine verification only (ASan/UBSan, 288 checks), built directly:
#   g++ -std=c++17 -fsanitize=address -DSURFACE_LITE_SINGLE_PROCESS=1 \
#     -I<surface>/interfaces/kits -I<surface>/interfaces/innerkits \
#     -I<surface>/frameworks -I<gfx>/interfaces/kits -I<gfx>/interfaces/innerkits \
#     -I<securec>/include \
#     <surface>/frameworks/{buffer_queue,surface,...}.cpp \
#     <surface>/test/example/surface_single_process_example.cpp \
#     memcpy_s.o memset_s.o securecutil.o -lpthread -o example
# An on-device target can be added here gated on
# ohos_build_type == "debug" && ohos_kernel_type == "liteos_m" if needed.
