import("//build/lite/config/component/lite_component.gni")
import("//build/lite/ndk/ndk.gni")
import("//foundation/graphic/surface_lite/surface_lite_config.gni")

# Common configuration of the "surface" target, shared by both kernel forms.
# Pure IPC and pure Gralloc translation units are compiled out of single
# process builds (their contents are unreachable by design).
surface_sources = [
  "frameworks/buffer_queue.cpp",
  "frameworks/buffer_queue_consumer.cpp",
  "frameworks/buffer_queue_producer.cpp",
  "frameworks/surface.cpp",
  "frameworks/surface_buffer_impl.cpp",
  "frameworks/surface_buffer_impl_ex.cpp",
  "frameworks/surface_impl.cpp",
  "frameworks/surface_proxy_impl.cpp",
  "frameworks/surface_utils.cpp",
]
surface_defines = []
surface_extra_deps = []
if (surface_lite_single_process) {
  surface_defines = [ "SURFACE_LITE_SINGLE_PROCESS=1" ]
} else {
  surface_sources += [
    "frameworks/buffer_client_producer.cpp",
    "frameworks/buffer_manager.cpp",
  ]
  surface_extra_deps = [
    "//drivers/peripheral/display/hal:hdi_display",
    "//foundation/communication/ipc/interfaces/innerkits/c/ipc:ipc_single",
  ]
}
surface_include_dirs = [
  "frameworks",
  "//drivers/peripheral/base",
  "//drivers/peripheral/display/interfaces/include",
]

lite_component("surface_lite") {
  features = [ ":surface" ]
  public_deps = features
}

ndk_lib("surface_lite_ndk") {
  lib_extension = ".so"
  deps = [ ":surface" ]
  head_files = [ "interfaces/kits" ]
}

# liteos_m (mini, bare-metal RTOS) has no dynamic linker: the target is a
# static library there and libsec links statically. Other kernels keep the
# original shared_library form (baseline identical). The branches below
# contain only these differences.
if (ohos_kernel_type == "liteos_m") {
  static_library("surface") {
    sources = surface_sources
    defines = surface_defines
    include_dirs = surface_include_dirs
    public_configs = [ ":surface_public_config" ]
    public_deps = [ "//foundation/graphic/graphic_utils_lite:utils_lite" ]
    deps = [ "//third_party/bounds_checking_function:libsec_static" ] + surface_extra_deps
    cflags = [ "-fPIC" ]
    cflags += [ "-Wall" ]
    cflags_cc = cflags
  }
} else {
  shared_library("surface") {
    sources = surface_sources
    defines = surface_defines
    include_dirs = surface_include_dirs
    public_configs = [ ":surface_public_config" ]
    public_deps = [ "//foundation/graphic/graphic_utils_lite:utils_lite" ]
    deps = [ "//third_party/bounds_checking_function:libsec_shared" ] + surface_extra_deps
    if (!surface_lite_single_process) {
      ldflags = [
        "-ldisplay_gfx",
        "-ldisplay_gralloc",
        "-ldisplay_layer",
      ]
    }
    cflags = [ "-fPIC" ]
    cflags += [ "-Wall" ]
    cflags_cc = cflags
  }
}

if (surface_lite_build_example) {
  assert(surface_lite_single_process,
         "surface_lite_build_example requires surface_lite_single_process")
  # Single process full-flow example: HAL producer thread + consumer thread
  # (attach -> acquire -> release -> OnBufferReleased -> driver memory return
  # -> ring reuse). Used by ASan/UBSan verification.
  executable("surface_lite_example") {
    sources = [ "test/example/surface_single_process_example.cpp" ]
    include_dirs = [ "frameworks" ]
    public_configs = [ ":surface_public_config" ]
    public_deps = [ ":surface" ]
    if (ohos_kernel_type == "liteos_m") {
      deps = [ "//third_party/bounds_checking_function:libsec_static" ]
    } else {
      deps = [ "//third_party/bounds_checking_function:libsec_shared" ]
    }
    cflags = [ "-Wall" ]
    cflags_cc = cflags
  }
}

config("surface_public_config") {
  include_dirs = [
    "interfaces/innerkits",
    "interfaces/kits",
    "//foundation/graphic/graphic_utils_lite/interfaces/kits",
  ]
}
